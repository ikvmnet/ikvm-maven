<?xml version="1.0" encoding="utf-8"?>
<Rule Name="ResolvedMavenArtifact" DisplayName="Maven Artifact" Description="Resolved Maven Artifact Properties" PageTemplate="generic" xmlns="http://schemas.microsoft.com/build/2009/properties">
    <Rule.DataSource>
        <DataSource HasConfigurationCondition="False" ItemType="MavenReference" MSBuildTarget="ResolveMavenReferencesDesignTime" Persistence="ResolvedReference" SourceOfDefaultValue="AfterContext" SourceType="TargetResults" />
    </Rule.DataSource>

    <Rule.Categories>
        <Category Name="Maven" DisplayName="Maven" />
        <Category Name="Assembly" DisplayName="Assembly" />
        <Category Name="Resolved" DisplayName="Resolved" />
    </Rule.Categories>

    <StringProperty Name="MavenGroupId" DisplayName="Group ID" Category="Maven" ReadOnly="True" Description="Group ID of the resolved artifact." />

    <StringProperty Name="MavenArtifactId" DisplayName="Artifact ID" Category="Maven" ReadOnly="True" Description="Artifact ID of the resolved artifact." />

    <StringProperty Name="MavenClassifier" DisplayName="Classifier" Category="Maven" ReadOnly="True" Description="Classifier of the resolved artifact." />

    <StringProperty Name="MavenVersion" DisplayName="Version" Category="Maven" ReadOnly="True" Description="Version Maven resolved for the artifact." />

    <StringProperty Name="AssemblyName" DisplayName="Assembly Name" Category="Assembly" ReadOnly="True" Description="Name of the generated assembly, when one was specified." />

    <StringProperty Name="FallbackAssemblyName" DisplayName="Fallback Assembly Name" Category="Assembly" ReadOnly="True" Description="Assembly name used when none can be derived from the JAR." />

    <StringProperty Name="FallbackAssemblyVersion" DisplayName="Fallback Assembly Version" Category="Assembly" ReadOnly="True" Description="Assembly version used when none can be derived from the JAR." />

    <StringListProperty Name="Compile" DisplayName="Classes" Category="Resolved" ReadOnly="True" Description="JAR files compiled into the assembly, in the local Maven repository." />

    <StringListProperty Name="References" DisplayName="Depends On" Category="Resolved" ReadOnly="True" Description="Resolved artifacts this one depends on." />

    <BoolProperty Name="ReferenceOutputAssembly" DisplayName="Referenced" Category="Resolved" ReadOnly="True" Description="Whether the generated assembly is referenced by the project, as it is for compile and provided scopes." />

    <BoolProperty Name="Private" DisplayName="Copy Local" Category="Resolved" ReadOnly="True" Description="Whether the generated assembly is copied to the output, as it is for compile and runtime scopes." />
</Rule>
